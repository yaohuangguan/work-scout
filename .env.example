# OpenMesh backend
WORKSCOUT_HOST=0.0.0.0
WORKSCOUT_INTERNAL_HOST=127.0.0.1
WORKSCOUT_GATEWAY_PORT=8787
WORKSCOUT_CONTROL_PORT=8790
WORKSCOUT_SEARCH_PORT=8791
WORKSCOUT_COMMUNITY_PORT=8792
WORKSCOUT_CONTROL_TOKEN=change-me-in-production
# Local default: SQLite. In production, set DATABASE_URL to use Postgres instead.
WORKSCOUT_DB_PATH=.data/workscout.sqlite
DATABASE_URL=

# Optional when frontend and API are deployed on different origins.
VITE_API_BASE=

WORKSCOUT_EXTERNAL_SEARCH=true
