{
  "name": "workscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,ui \"npm:dev:worker\" \"npm:dev:ui\"",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local --port 8787",
    "types:worker": "wrangler types worker-configuration.d.ts",
    "seo:generate": "node scripts/generate-seo-pages.mjs",
    "build": "npm run seo:generate && vite build",
    "typecheck": "npm run types:worker && tsc --noEmit",
    "test": "vitest run",
    "smoke": "bash ./scripts/smoke.sh",
    "check": "npm run seo:generate && npm run typecheck && npm test && vite build",
    "deploy": "npm run check && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute workscout-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute workscout-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "openmesh-node": "^0.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "description": "Find remote work you can actually take.",
  "homepage": "https://workscout.nzs.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaohuangguan/work-scout.git"
  },
  "bugs": {
    "url": "https://github.com/yaohuangguan/work-scout/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
