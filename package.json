{
  "name": "workscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "wrangler dev --local --port 8788",
    "build": "npm run build:ui && npm run build:api",
    "build:ui": "vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist-server/index.mjs",
    "start:api": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "./scripts/smoke-openmesh.sh",
    "smoke:legacy": "./scripts/smoke.sh",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "deploy:worker": "npm run check && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute workscout-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute workscout-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "openmesh-node": "^0.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "description": "Find remote work you can actually take.",
  "homepage": "https://workscout.nzs.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaohuangguan/work-scout.git"
  },
  "bugs": {
    "url": "https://github.com/yaohuangguan/work-scout/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
